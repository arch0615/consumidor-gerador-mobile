# ACVEL Consumidor — HOMOLOGATION configuration (no secrets; every EXPO_PUBLIC_* value is embedded in the app bundle).
# Use: copy to .env (git-ignored) before building. Demo/QA builds against homologation.
# Firebase native files must match: project teste---00 (firebase/ folder).
EXPO_PUBLIC_APP_ENV=preview
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_AUTH_API_URL=https://api-acvel.souaiv.com/api/auth
EXPO_PUBLIC_BUSINESS_API_URL=https://api-acvel.souaiv.com/api/business
EXPO_PUBLIC_RATEIO_API_URL=https://api-acvel.souaiv.com/api/rateio
EXPO_PUBLIC_API_TIMEOUT_MS=20000
# Homologation consumer portal (referral codes of homologation accounts exist only here).
EXPO_PUBLIC_CONSUMIDOR_APP_URL=https://cliente-test.appacvel.com.br
EXPO_PUBLIC_TERMS_URL=https://cliente-test.appacvel.com.br/termos-de-uso-e-privacidade
EXPO_PUBLIC_PRIVACY_URL=https://cliente-test.appacvel.com.br/termos-de-uso-e-privacidade

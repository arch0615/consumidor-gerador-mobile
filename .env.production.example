# ACVEL Consumidor — PRODUCTION configuration (no secrets; every EXPO_PUBLIC_* value is embedded in the app bundle).
# Use: copy to .env (git-ignored) before building. Store builds.
# Firebase native files must match: project acvel-prod (firebase/ folder).
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_AUTH_API_URL=https://api.appacvel.com.br/api/auth
EXPO_PUBLIC_BUSINESS_API_URL=https://api.appacvel.com.br/api/business
EXPO_PUBLIC_RATEIO_API_URL=https://api.appacvel.com.br/api/rateio
EXPO_PUBLIC_API_TIMEOUT_MS=20000
EXPO_PUBLIC_CONSUMIDOR_APP_URL=https://cliente.appacvel.com.br
EXPO_PUBLIC_TERMS_URL=https://cliente.appacvel.com.br/termos-de-uso-e-privacidade
EXPO_PUBLIC_PRIVACY_URL=https://cliente.appacvel.com.br/termos-de-uso-e-privacidade

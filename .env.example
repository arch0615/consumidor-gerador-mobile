# ACVEL Consumidor mobile — copy to `.env` (git-ignored) and fill in.
# Every EXPO_PUBLIC_* value is embedded in the app bundle: never put secrets here.

# development | preview | production  (production rejects mocks and non-https URLs)
EXPO_PUBLIC_APP_ENV=development

# true = in-memory mock data layer (development/QA only). false = real APIs.
EXPO_PUBLIC_USE_MOCKS=true

# Backend base URLs — WITHOUT the `/v1` suffix (paths already start with /v1/...).
# Auth API: consumidor-gerador-api (Swagger at <url>/docs) or the legacy auth-api.
EXPO_PUBLIC_AUTH_API_URL=
# Business API: consumers, units, documents, notifications, support, points, marketplace, referral.
EXPO_PUBLIC_BUSINESS_API_URL=
# Rateio API: invoices, payments (Pix/boleto), UC billing mode, bill OCR.
EXPO_PUBLIC_RATEIO_API_URL=

# Request timeout in ms (1000–120000). Default 20000.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Firebase Authentication (same project as the web portal). Required when mocks are off.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Consumer web portal origin, used to build referral links (<portal>/indicacao/<code>).
EXPO_PUBLIC_PORTAL_URL=https://cliente.appacvel.com.br

# Optional: CEP lookup service (defaults to BrasilAPI v2, same as the web portal).
EXPO_PUBLIC_CEP_API_URL=

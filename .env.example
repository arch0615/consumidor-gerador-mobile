# ACVEL Consumidor mobile — copy to `.env` (git-ignored) and fill in.
# Every EXPO_PUBLIC_* value is embedded in the app bundle: never put secrets here.

# development | preview | production  (production rejects mocks and non-https URLs)
EXPO_PUBLIC_APP_ENV=development

# true = in-memory mock data layer (development/QA only). false = real APIs.
EXPO_PUBLIC_USE_MOCKS=true

# Backend base URLs — WITHOUT the `/v1` suffix (paths already start with /v1/...).
# Auth API: consumidor-gerador-api (Swagger at <url>/docs) or the legacy auth-api.
EXPO_PUBLIC_AUTH_API_URL=
# Business API: consumers, units, documents, notifications, support, points, marketplace, referral.
EXPO_PUBLIC_BUSINESS_API_URL=
# Rateio API: invoices, payments (Pix/boleto), UC billing mode, bill OCR.
EXPO_PUBLIC_RATEIO_API_URL=

# Request timeout in ms (1000–120000). Default 20000.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Firebase Authentication is configured natively (no env vars): place the client's
# firebase/google-services-android.json and firebase/GoogleService-Info.plist
# (package / bundle id com.acvel.app) and build a development build.

# Consumer web portal (cliente.appacvel.com.br). Used for referral links (<portal>/indicacao/<codigo>)
# and portal links (/auth/login, /auth/cadastro?codigo_representante=<codigo>, /faturas).
# Homologation portal: https://cliente-test.appacvel.com.br (the homologation API returns referral links there).
# Legacy name EXPO_PUBLIC_PORTAL_URL is still read as a fallback.
EXPO_PUBLIC_CONSUMIDOR_APP_URL=https://cliente.appacvel.com.br

# Legal: one combined page — there is no separate privacy route. When equal, the app shows a single
# "Termos de uso e privacidade" entry. Both default to <portal>/termos-de-uso-e-privacidade.
EXPO_PUBLIC_TERMS_URL=https://cliente.appacvel.com.br/termos-de-uso-e-privacidade
EXPO_PUBLIC_PRIVACY_URL=https://cliente.appacvel.com.br/termos-de-uso-e-privacidade

# Optional: CEP lookup service (defaults to BrasilAPI v2, same as the web portal).
EXPO_PUBLIC_CEP_API_URL=
